```mermaid
graph TB
    subgraph "User Roles"
        Anonymous[Anonymous<br/>No Authentication]
        User[User<br/>Free Tier<br/>1 Active Session]
        Trader[Trader<br/>Paid Subscription<br/>10 Active Sessions]
        Expert[Expert<br/>Paid Subscription<br/>30 Active Sessions]
        Admin[Admin<br/>Internal Role<br/>Unlimited Sessions]
    end

    subgraph "Role-Based Access Control"
        PublicAccess[Public Access<br/>No Auth Required]
        AuthenticatedAccess[Authenticated Access<br/>Any Logged In User]
        SubscriptionAccess[Subscription Access<br/>Trader or Expert]
        AdminAccess[Admin Access<br/>Admin Role Only]
    end

    subgraph "Resource Permissions"
        OwnResources[Own Resources<br/>User Owns Resource<br/>OR Admin]
        SessionLimits[Session Limits<br/>Based on Role]
        AdminResources[Admin Resources<br/>Admin Only]
    end

    subgraph "Protected Routes"
        AuthRoutes[Auth Routes<br/>Login, Register, Refresh]
        UserRoutes[User Routes<br/>Profile, Settings]
        SessionRoutes[Session Routes<br/>Create, View, Manage]
        PositionRoutes[Position Routes<br/>Open, Close, Update]
        SubscriptionRoutes[Subscription Routes<br/>View, Manage]
        AdminRoutes[Admin Routes<br/>User Management, Datasets]
    end

    Anonymous --> PublicAccess
    User --> AuthenticatedAccess
    Trader --> AuthenticatedAccess
    Trader --> SubscriptionAccess
    Expert --> AuthenticatedAccess
    Expert --> SubscriptionAccess
    Admin --> AuthenticatedAccess
    Admin --> AdminAccess
    
    PublicAccess --> AuthRoutes
    AuthenticatedAccess --> UserRoutes
    AuthenticatedAccess --> SessionRoutes
    AuthenticatedAccess --> PositionRoutes
    AuthenticatedAccess --> SubscriptionRoutes
    
    SubscriptionAccess --> SessionLimits
    AdminAccess --> AdminRoutes
    AdminAccess --> AdminResources
    
    SessionRoutes --> OwnResources
    PositionRoutes --> OwnResources
    UserRoutes --> OwnResources
    
    User --> SessionLimits
    Trader --> SessionLimits
    Expert --> SessionLimits
    Admin --> SessionLimits

    style Anonymous fill:#9e9e9e
    style User fill:#4a90e2
    style Trader fill:#ffa500
    style Expert fill:#ff6b6b
    style Admin fill:#f44336
    style AdminAccess fill:#ffcdd2
