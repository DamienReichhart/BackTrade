graph TB
  subgraph Route_Configuration["Route Configuration"]
    direction TB

    RootRoute["/<br/>App Component"]

    subgraph Public_Routes["Public Routes"]
      HomeRoute["/<br/>Home Page"]
      PricingRoute["/pricing<br/>Pricing Page"]
      LegalRoute["/legal/*<br/>Terms, Privacy"]
    end

    subgraph Auth_Routes["Auth Routes"]
      LoginRoute["/login<br/>Login Page"]
      RegisterRoute["/register<br/>Registration Page"]
      ForgotPasswordRoute["/forgot-password<br/>Password Reset Request"]
      ResetPasswordRoute["/reset-password<br/>Password Reset Form"]
    end

    subgraph Dashboard_Routes["Dashboard Routes"]
      DashboardRoute["/dashboard<br/>Dashboard Overview"]
      SettingsRoute["/dashboard/settings<br/>User Settings"]
      PlansRoute["/dashboard/plans<br/>Subscription Plans"]
      PurchaseSuccessRoute["/dashboard/plans/purchase-success<br/>Stripe Success"]
    end

    subgraph Session_Routes["Session Routes"]
      SessionCreateRoute["/sessions/create<br/>Create Session"]
      SessionRunningRoute["/sessions/:id/running<br/>Running Session"]
      SessionAnalyticsRoute["/sessions/:id/analytics<br/>Session Analytics"]
    end

    subgraph Admin_Routes["Admin Routes"]
      AdminChoicesRoute["/dashboard/admin<br/>Admin Dashboard"]
      UserManagementRoute["/dashboard/admin/user-management<br/>User Management"]
      DatasetManagementRoute["/dashboard/admin/dataset-management<br/>Dataset Management"]
      InstrumentManagementRoute["/dashboard/admin/instrument-management<br/>Instrument Management"]
    end

    subgraph Error_Routes["Error Routes"]
      NotFoundRoute["/*<br/>404 Not Found"]
      ServerErrorRoute["/error<br/>500 Server Error"]
    end
  end

  subgraph Route_Protection["Route Protection"]
    direction TB
    PublicAccess["Public Access<br/>No Authentication"]
    AuthRequired["Authentication Required<br/>Auth Middleware"]
    AdminRequired["Admin Role Required<br/>Admin Check"]
  end

