graph TB
    subgraph "Application Entry"
        Main[main.tsx<br/>React Root]
        ErrorBoundary[Error Boundary<br/>Global Error Handler]
        QueryClient[Query Client Provider<br/>React Query]
        AuthInitializer[Auth Initializer<br/>Token Check]
        RouterProvider[Router Provider<br/>React Router]
    end

    subgraph "Routing Layer"
        Router[Browser Router]
        PublicRoutes[Public Routes<br/>Home, Pricing, Legal]
        AuthRoutes[Auth Routes<br/>Login, Register, Reset]
        DashboardRoutes[Dashboard Routes<br/>Dashboard, Settings, Plans]
        SessionRoutes[Session Routes<br/>Create, Running, Analytics]
        AdminRoutes[Admin Routes<br/>User, Dataset, Instrument Management]
        ErrorRoutes[Error Routes<br/>404, 500]
    end

    subgraph "Feature Modules"
        AuthFeature[Auth Feature<br/>Login, Register, Password Reset]
        DashboardFeature[Dashboard Feature<br/>Overview, Statistics]
        SessionFeature[Session Feature<br/>Creation, Running, Analytics]
        PlansFeature[Plans Feature<br/>Subscription Management]
        AdminFeature[Admin Feature<br/>User, Dataset Management]
        SettingsFeature[Settings Feature<br/>User Preferences]
    end

    subgraph "State Management"
        ZustandStore[Zustand Stores]
        AuthStore[Auth Store<br/>Tokens, User Data]
        SessionStore[Session Store<br/>Current Session State]
        ChartStore[Chart Store<br/>Chart Settings]
        ReactQuery[React Query<br/>Server State Cache]
    end

    subgraph "API Layer"
        APIHooks[API Hooks<br/>useGet, usePost, usePatch, useDelete]
        RequestUtils[Request Utils<br/>Refresh Token, Error Handling]
        RequestTypes[Request Types<br/>Auth, Sessions, Positions, etc.]
    end

    subgraph "Shared Components"
        LayoutComponents[Layout Components<br/>Header, Footer, AuthenticatedLayout]
        UIComponents[UI Components<br/>Button, Input, Select, Modal]
        ErrorComponents[Error Components<br/>ErrorBoundary, Error Pages]
    end

    Main --> ErrorBoundary
    ErrorBoundary --> QueryClient
    QueryClient --> AuthInitializer
    AuthInitializer --> RouterProvider
    RouterProvider --> Router
    
    Router --> PublicRoutes
    Router --> AuthRoutes
    Router --> DashboardRoutes
    Router --> SessionRoutes
    Router --> AdminRoutes
    Router --> ErrorRoutes
    
    PublicRoutes --> AuthFeature
    AuthRoutes --> AuthFeature
    DashboardRoutes --> DashboardFeature
    DashboardRoutes --> PlansFeature
    DashboardRoutes --> SettingsFeature
    DashboardRoutes --> AdminFeature
    SessionRoutes --> SessionFeature
    
    AuthFeature --> APIHooks
    DashboardFeature --> APIHooks
    SessionFeature --> APIHooks
    PlansFeature --> APIHooks
    AdminFeature --> APIHooks
    
    APIHooks --> RequestUtils
    APIHooks --> RequestTypes
    
    AuthFeature --> AuthStore
    SessionFeature --> SessionStore
    SessionFeature --> ChartStore
    
    AuthStore --> ZustandStore
    SessionStore --> ZustandStore
    ChartStore --> ZustandStore
    
    AuthFeature --> LayoutComponents
    DashboardFeature --> LayoutComponents
    SessionFeature --> LayoutComponents
    AdminFeature --> LayoutComponents
    
    AuthFeature --> UIComponents
    DashboardFeature --> UIComponents
    SessionFeature --> UIComponents
    PlansFeature --> UIComponents

