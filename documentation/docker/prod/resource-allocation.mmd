
graph TB
    subgraph "Resource Limits & Reservations"
        direction TB
        
        subgraph "High Resource Services"
            Backend[Backend API<br/>Limits: 8 CPU, 16GB RAM<br/>Reservations: 0.5 CPU, 512MB RAM<br/>Logs: 10MB x 5 files]
            ClickHouse[ClickHouse<br/>Limits: 4 CPU, 16GB RAM<br/>Reservations: 0.5 CPU, 1GB RAM<br/>Logs: 10MB x 3 files]
            Postgres[PostgreSQL<br/>Limits: 2 CPU, 8GB RAM<br/>Reservations: 0.5 CPU, 1GB RAM<br/>Logs: 10MB x 3 files]
        end
        
        subgraph "Medium Resource Services"
            Worker[Worker Service<br/>Limits: 2 CPU, 8GB RAM<br/>Reservations: 0.5 CPU, 512MB RAM<br/>Logs: 10MB x 5 files]
            Redis[Redis<br/>Limits: 1 CPU, 8GB RAM<br/>Reservations: 0.25 CPU, 512MB RAM<br/>Logs: 10MB x 3 files]
            MinIO[MinIO<br/>Limits: 1 CPU, 4GB RAM<br/>Reservations: 0.25 CPU, 512MB RAM<br/>Logs: 10MB x 3 files]
        end
        
        subgraph "Low Resource Services"
            Scheduler[Scheduler Service<br/>Limits: 1 CPU, 1GB RAM<br/>Reservations: 0.25 CPU, 256MB RAM<br/>Logs: 10MB x 5 files]
            Frontend[Frontend<br/>Limits: 1 CPU, 512MB RAM<br/>Reservations: 0.25 CPU, 128MB RAM<br/>Logs: 10MB x 3 files]
            RabbitMQ[RabbitMQ<br/>Limits: 1 CPU, 2GB RAM<br/>Reservations: 0.25 CPU, 512MB RAM<br/>Logs: 10MB x 3 files]
            Proxy[Proxy<br/>No Limits Set<br/>Logs: 10MB x 3 files]
            Cloudflared[Cloudflared<br/>No Limits Set<br/>Logs: 10MB x 3 files]
            Migrate[Migrate Service<br/>No Limits Set<br/>Runs Once<br/>Logs: 10MB x 3 files]
        end
    end

    subgraph "Resource Summary"
        direction LR
        TotalCPU["Total CPU Limits: ~20 cores<br/>Total CPU Reservations: ~3.5 cores"]
        TotalRAM["Total RAM Limits: ~60GB<br/>Total RAM Reservations: ~5GB"]
        LogRotation["Log Rotation:<br/>Max Size: 10MB per file<br/>Max Files: 3-5 per service<br/>Total Log Space: ~150-250MB"]
    end

    subgraph "Persistent Storage"
        direction TB
        VolDB[backtrade_db<br/>PostgreSQL Data<br/>Size: Variable]
        VolMinIO[backtrade_minio_data<br/>MinIO Object Storage<br/>Size: Variable]
        VolClickHouse[backtrade_clickhouse_data<br/>ClickHouse Analytics<br/>Size: Variable]
        VolRabbitMQ[backtrade_rabbitmq_data<br/>RabbitMQ Messages<br/>Size: Variable]
    end

    Backend --> TotalCPU
    ClickHouse --> TotalCPU
    Postgres --> TotalCPU
    Worker --> TotalCPU
    Redis --> TotalCPU
    MinIO --> TotalCPU
    Scheduler --> TotalCPU
    Frontend --> TotalCPU
    RabbitMQ --> TotalCPU
    
    Backend --> TotalRAM
    ClickHouse --> TotalRAM
    Postgres --> TotalRAM
    Worker --> TotalRAM
    Redis --> TotalRAM
    MinIO --> TotalRAM
    Scheduler --> TotalRAM
    Frontend --> TotalRAM
    RabbitMQ --> TotalRAM

    Postgres --> VolDB
    MinIO --> VolMinIO
    ClickHouse --> VolClickHouse
    RabbitMQ --> VolRabbitMQ

    style Backend fill:#339933
    style ClickHouse fill:#ffcc02
    style Postgres fill:#336791
    style Worker fill:#ff6b6b
    style Redis fill:#dc382d
    style MinIO fill:#c03
    style Scheduler fill:#ff6b6b
    style Frontend fill:#61dafb
    style RabbitMQ fill:#ff6600
    style TotalCPU fill:#e3f2fd
    style TotalRAM fill:#e3f2fd
