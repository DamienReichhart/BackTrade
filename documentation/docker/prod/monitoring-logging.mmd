# BackTrade Production Monitoring & Logging

```mermaid
graph TB
    subgraph "Logging Architecture"
        direction TB
        
        subgraph "Log Configuration"
            LogDriver[JSON File Driver<br/>All Services]
            LogSize[Max Size: 10MB per file]
            LogFiles[Max Files: 3-5 per service]
            LogRotation[Automatic Rotation<br/>Oldest files deleted]
        end
        
        subgraph "Log Locations"
            DockerLogs[Docker Logs<br/>docker compose logs]
            LogFiles1[Container Log Files<br/>/var/lib/docker/containers/]
            Stdout[Stdout/Stderr<br/>Distroless containers]
        end
        
        subgraph "Service-Specific Logging"
            BackendLogs[Backend API<br/>Structured JSON Logs<br/>Pino Logger<br/>10MB x 5 files]
            WorkerLogs[Worker Service<br/>Job Processing Logs<br/>10MB x 5 files]
            SchedulerLogs[Scheduler Service<br/>Cron Job Logs<br/>10MB x 5 files]
            FrontendLogs[Frontend Nginx<br/>Access & Error Logs<br/>10MB x 3 files]
            ProxyLogs[Proxy Nginx<br/>Access & Error Logs<br/>10MB x 3 files]
            DBLogs[Database Logs<br/>PostgreSQL, Redis, etc.<br/>10MB x 3 files]
        end
    end

    subgraph "Health Monitoring"
        direction TB
        
        subgraph "Built-in Health Checks"
            HCPostgres[PostgreSQL<br/>Interval: 10s<br/>Timeout: 5s<br/>Retries: 5<br/>Start: 30s]
            HCRedis[Redis<br/>Interval: 10s<br/>Timeout: 5s<br/>Retries: 5<br/>Start: 10s]
            HCClickHouse[ClickHouse<br/>Interval: 30s<br/>Timeout: 10s<br/>Retries: 3<br/>Start: 60s]
            HCMinIO[MinIO<br/>Interval: 30s<br/>Timeout: 10s<br/>Retries: 3<br/>Start: 30s]
            HCRabbitMQ[RabbitMQ<br/>Interval: 30s<br/>Timeout: 10s<br/>Retries: 3<br/>Start: 60s]
            HCBackend[Backend API<br/>Interval: 30s<br/>Timeout: 10s<br/>Retries: 3<br/>Start: 40s<br/>Endpoint: /api/v1/health]
            HCCloudflared[Cloudflared<br/>Interval: 30s<br/>Timeout: 10s<br/>Retries: 3<br/>Start: 10s]
        end
        
        subgraph "External Monitoring Required"
            ExtProxy[Proxy<br/>No built-in health check<br/>Monitor: HTTP /health endpoint]
            ExtFrontend[Frontend<br/>No built-in health check<br/>Monitor: HTTP responses]
            ExtWorker[Worker<br/>No built-in health check<br/>Monitor: Process status]
            ExtScheduler[Scheduler<br/>No built-in health check<br/>Monitor: Process status]
        end
    end

    subgraph "Monitoring Strategies"
        direction LR
        
        subgraph "Container Monitoring"
            ContainerStats[docker stats<br/>Real-time CPU/Memory]
            ContainerPS[docker compose ps<br/>Service status]
            ContainerInspect[docker inspect<br/>Detailed container info]
        end
        
        subgraph "Application Monitoring"
            HealthEndpoints[Health Check Endpoints<br/>/api/v1/health]
            MetricsEndpoints[Metrics Endpoints<br/>Future: Prometheus metrics]
            LogAnalysis[Log Analysis<br/>Structured JSON logs]
        end
        
        subgraph "Infrastructure Monitoring"
            NetworkMonitor[Network Monitoring<br/>docker network inspect]
            VolumeMonitor[Volume Monitoring<br/>docker volume inspect]
            ResourceMonitor[Resource Monitoring<br/>CPU, Memory, Disk]
        end
    end

    subgraph "Recommended Monitoring Tools"
        direction TB
        Tool1[Prometheus<br/>Metrics Collection]
        Tool2[Grafana<br/>Visualization & Dashboards]
        Tool3[ELK Stack<br/>Log Aggregation]
        Tool4[Loki<br/>Log Aggregation<br/>Lightweight Alternative]
        Tool5[AlertManager<br/>Alerting]
    end

