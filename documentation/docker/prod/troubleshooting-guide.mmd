            Check1{Check Logs}
            Logs1[docker compose logs service-name]
            Check2{Check Dependencies}
            Deps1[Verify dependent services are healthy]
            Check3{Check Environment Variables}
            Env1[Verify all required env vars are set]
            Check4{Check Resource Limits}
            Res1[Verify sufficient CPU/memory available]
            
            Issue1 --> Check1
            Check1 --> Logs1
            Logs1 --> Check2
            Check2 --> Deps1
            Deps1 --> Check3
            Check3 --> Env1
            Env1 --> Check4
            Check4 --> Res1
        end
        
        subgraph "Database Connection Issues"
            Issue2[Cannot Connect to Database]
            Check5{Check Service Health}
            Health1[docker compose ps<br/>Verify service is healthy]
            Check6{Check Network}
            Net1[Verify service is on backend network<br/>Check IP: 192.168.250.x]
            Check7{Check Credentials}
            Cred1[Verify DATABASE_URL env var<br/>Check username/password]
            Check8{Check Migration Status}
            Mig1[Verify migrate service completed<br/>Check migration logs]
            
            Issue2 --> Check5
            Check5 --> Health1
            Health1 --> Check6
            Check6 --> Net1
            Net1 --> Check7
            Check7 --> Cred1
            Cred1 --> Check8
            Check8 --> Mig1
        end
        
        subgraph "Frontend Not Loading"
            Issue3[Frontend Returns 502/503]
            Check9{Check Proxy}
            Proxy1[Verify proxy is running<br/>docker compose ps proxy]
            Check10{Check Frontend}
            Front1[Verify frontend is running<br/>Check logs for errors]
            Check11{Check Backend Health}
            Back1[Verify backend health check passes<br/>curl http://192.168.251.12:21799/api/v1/health]
            Check12{Check Network Connectivity}
            Net2[Verify proxy can reach frontend<br/>192.168.251.11:8080]
            
            Issue3 --> Check9
            Check9 --> Proxy1
            Proxy1 --> Check10
            Check10 --> Front1
            Front1 --> Check11
            Check11 --> Back1
            Back1 --> Check12
            Check12 --> Net2
        end
        
        subgraph "Worker Not Processing Jobs"
            Issue4[Jobs Stuck in Queue]
            Check13{Check RabbitMQ}
            RMQ1[Verify RabbitMQ is healthy<br/>Check management UI: port 15672]
            Check14{Check Worker Logs}
            Work1[docker compose logs worker<br/>Check for errors]
            Check15{Check Worker Connection}
            Conn1[Verify RABBITMQ_HOST/PORT env vars<br/>Test connection to 192.168.250.31:5672]
            Check16{Check Queue Name}
            Queue1[Verify RABBITMQ_QUEUE_NAME matches<br/>Check queue exists in RabbitMQ]
            
            Issue4 --> Check13
            Check13 --> RMQ1
            RMQ1 --> Check14
            Check14 --> Work1
            Work1 --> Check15
            Check15 --> Conn1
            Conn1 --> Check16
            Check16 --> Queue1
        end
        
        subgraph "High Resource Usage"
            Issue5[Service Consuming Too Many Resources]
            Check17{Check Resource Limits}
            Limit1[Review limits in docker-prod.yaml<br/>Adjust if needed]
            Check18{Check Logs Size}
            LogSize[Check log file sizes<br/>docker compose logs --tail=100]
            Check19{Check Database Queries}
            DBQ[Check slow queries in PostgreSQL<br/>Enable query logging]
            Check20{Check Cache Hit Rate}
            Cache1[Monitor Redis cache performance<br/>Check hit/miss ratios]
            
            Issue5 --> Check17
            Check17 --> Limit1
            Limit1 --> Check18
            Check18 --> LogSize
            LogSize --> Check19
            Check19 --> DBQ
            DBQ --> Check20
            Check20 --> Cache1
        end
        
        subgraph "Migration Failures"
            Issue6[Database Migration Fails]
            Check21{Check Migration Logs}
