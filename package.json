        "test": "turbo run test",
        "test:coverage": "turbo run test:coverage",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.5.0",
        "prettier": "^3.8.4",
        "turbo": "^2.9.18",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0"
    },
    "keywords": [],
