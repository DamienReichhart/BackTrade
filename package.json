    "version": "1.0.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "description": "",
    "scripts": {
        "dev": "turbo run dev --parallel",
        "build": "turbo run build --parallel",
        "start": "turbo run start --parallel",
        "typecheck": "turbo run typecheck",
