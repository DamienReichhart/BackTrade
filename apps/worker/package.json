{
    "name": "@backtrade/data-worker",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nodemon --legacy-watch --watch src --ext ts,js,json --exec tsx src/worker.ts",
        "build": "tsx scripts/build.ts",
        "start": "node dist/worker.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "dependencies": {
        "@backtrade/data": "workspace:*",
        "@backtrade/logger": "workspace:*",
        "@backtrade/mailer": "workspace:*",
        "@backtrade/queue": "workspace:*",
        "@backtrade/storage": "workspace:*",
        "@backtrade/types": "workspace:*",
        "@backtrade/utils": "workspace:*",
        "dotenv": "^17.2.3",
        "mjml": "^4.18.0",
        "zod": "4.3.5"
    },
    "devDependencies": {
        "@backtrade/eslint-config": "workspace:*",
        "@backtrade/tsconfig": "workspace:*",
        "@eslint/js": "^9.39.2",
        "@types/jest": "30.0.0",
        "@types/node": "25.2.0",
        "esbuild": "0.27.2",
        "eslint": "^9.39.2",
        "globals": "^17.0.0",
        "jest": "30.2.0",
        "nodemon": "^3.1.11",
        "ts-jest": "^29.4.6",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "8.54.0"
    },
    "license": "PROPRIETARY",
    "author": "REICHHART Damien"
}
