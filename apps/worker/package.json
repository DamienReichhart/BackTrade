{
    "name": "@backtrade/data-worker",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nodemon --legacy-watch --watch src --ext ts,js,json --exec tsx src/worker.ts",
        "build": "tsx scripts/build.ts",
        "start": "node dist/worker.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@backtrade/types": "workspace:*",
        "@backtrade/utils": "workspace:*",
        "amqplib": "^0.10.9",
        "dotenv": "^17.2.3",
        "pino": "10.1.0",
        "zod": "4.2.1"
    },
    "devDependencies": {
        "@backtrade/eslint-config": "workspace:*",
        "@backtrade/tsconfig": "workspace:*",
        "@eslint/js": "^9.39.2",
        "@types/amqplib": "^0.10.8",
        "@types/node": "25.0.2",
        "esbuild": "0.27.1",
        "eslint": "^9.39.2",
        "globals": "^16.5.0",
        "nodemon": "^3.1.11",
        "pino-pretty": "^13.1.3",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "8.50.0"
    },
    "license": "PROPRIETARY",
    "author": "REICHHART Damien"
}
