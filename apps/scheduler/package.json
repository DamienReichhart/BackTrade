{
    "name": "@backtrade/scheduler",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nodemon --legacy-watch --watch src --ext ts,js,json --exec tsx src/scheduler.ts",
        "build": "tsx scripts/build.ts",
        "start": "node dist/scheduler.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "dependencies": {
        "@backtrade/data": "workspace:*",
        "@backtrade/logger": "workspace:*",
        "@backtrade/queue": "workspace:*",
        "@backtrade/types": "workspace:*",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "dotenv": "^17.4.2",
        "node-cron": "^4.2.1",
        "pg": "^8.21.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@backtrade/eslint-config": "workspace:*",
        "@backtrade/tsconfig": "workspace:*",
        "@eslint/js": "^10.0.1",
        "@types/jest": "30.0.0",
        "@types/node": "25.9.1",
        "@types/node-cron": "^3.0.11",
        "esbuild": "0.28.0",
        "eslint": "^10.4.0",
        "globals": "^17.6.0",
        "jest": "30.4.2",
        "nodemon": "^3.1.14",
        "ts-jest": "^29.4.11",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.60.0"
    },
    "license": "PROPRIETARY",
    "author": "REICHHART Damien"
}
