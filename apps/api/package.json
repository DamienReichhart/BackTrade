{
    "name": "@backtrade/api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nodemon --legacy-watch --watch src --ext ts,js,json --exec tsx src/server.ts",
        "build": "tsx scripts/build.ts",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "db:seed": "tsx prisma/seed/index.ts"
    },
    "dependencies": {
        "@backtrade/cache": "workspace:*",
        "@backtrade/data": "workspace:*",
        "@backtrade/logger": "workspace:*",
        "@backtrade/mailer": "workspace:*",
        "@backtrade/queue": "workspace:*",
        "@backtrade/storage": "workspace:*",
        "@backtrade/types": "workspace:*",
        "@backtrade/utils": "workspace:*",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "argon2": "^0.44.0",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "decimal.js": "^10.6.0",
        "dotenv": "^17.4.2",
        "express": "5.2.1",
        "express-rate-limit": "8.5.2",
        "helmet": "8.2.0",
        "html-minifier": "^4.0.0",
        "jsonwebtoken": "^9.0.3",
        "mjml": "^5.3.0",
        "mjml-core": "^5.3.0",
        "multer": "^2.2.0",
        "pg": "^8.22.0",
        "pino-http": "11.0.0",
        "stripe": "^22.2.3",
        "uglify-js": "^3.19.3",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@backtrade/eslint-config": "workspace:*",
        "@backtrade/tsconfig": "workspace:*",
        "@eslint/js": "^10.0.1",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mjml": "^5.0.0",
        "@types/multer": "^2.2.0",
        "@types/node": "26.1.2",
        "@types/nodemailer": "^8.0.1",
        "esbuild": "0.28.1",
        "eslint": "^10.8.0",
        "globals": "^17.7.0",
        "jest": "30.4.2",
        "nodemon": "^3.1.14",
        "ts-jest": "^29.4.11",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.66.0"
    },
    "license": "PROPRIETARY",
    "author": "REICHHART Damien"
}
