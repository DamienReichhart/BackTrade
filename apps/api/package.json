{
    "name": "@backtrade/api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nodemon --legacy-watch --watch src --ext ts,js,json --exec tsx src/server.ts",
        "build": "tsx scripts/build.ts",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "db:seed": "tsx prisma/seed/index.ts"
    },
    "dependencies": {
        "@backtrade/cache": "workspace:*",
        "@backtrade/data": "workspace:*",
        "@backtrade/logger": "workspace:*",
        "@backtrade/mailer": "workspace:*",
        "@backtrade/queue": "workspace:*",
        "@backtrade/storage": "workspace:*",
        "@backtrade/types": "workspace:*",
        "@backtrade/utils": "workspace:*",
        "@prisma/adapter-pg": "^7.2.0",
        "@prisma/client": "^7.2.0",
        "argon2": "^0.44.0",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "decimal.js": "^10.6.0",
        "dotenv": "^17.2.3",
        "express": "5.2.1",
        "express-rate-limit": "8.2.1",
        "helmet": "8.1.0",
        "html-minifier": "^4.0.0",
        "jsonwebtoken": "^9.0.3",
        "mjml": "^4.18.0",
        "mjml-core": "^4.18.0",
        "multer": "^2.0.2",
        "pg": "^8.17.1",
        "pino-http": "11.0.0",
        "uglify-js": "^3.19.3",
        "stripe": "^20.2.0",
        "zod": "4.3.5"
    },
    "devDependencies": {
        "@backtrade/eslint-config": "workspace:*",
        "@backtrade/tsconfig": "workspace:*",
        "@eslint/js": "^9.39.2",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mjml": "^4.7.4",
        "@types/multer": "^2.0.0",
        "@types/node": "25.0.9",
        "@types/nodemailer": "^7.0.5",
        "esbuild": "0.27.2",
        "eslint": "^9.39.2",
        "globals": "^17.0.0",
        "jest": "30.2.0",
        "nodemon": "^3.1.11",
        "ts-jest": "^29.4.6",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "8.53.0"
    },
    "license": "PROPRIETARY",
    "author": "REICHHART Damien"
}
