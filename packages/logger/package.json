{
    "name": "@backtrade/logger",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "require": "./src/index.ts"
        }
    },
    "scripts": {
        "dev": "npx tsc --watch --project tsconfig.json",
        "build": "npx tsc --project tsconfig.json",
        "lint": "eslint . --ext .ts,.tsx",
        "lint:fix": "eslint . --ext .ts,.tsx --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "npx tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "dependencies": {
        "@backtrade/types": "workspace:*",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3"
    },
    "license": "PROPRIETARY",
    "author": "REICHHART Damien",
    "devDependencies": {
        "@backtrade/eslint-config": "workspace:*",
        "@backtrade/tsconfig": "workspace:*",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/node": "^26.1.0",
        "globals": "^17.7.0",
        "jest": "30.4.2",
        "ts-jest": "^29.4.11",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.62.1"
    }
}
