{
    "name": "@backtrade/mailer",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "require": "./src/index.ts"
        }
    },
    "scripts": {
        "dev": "npx tsc --watch --project tsconfig.json",
        "build": "npx tsc --project tsconfig.json",
        "lint": "eslint . --ext .ts,.tsx",
        "lint:fix": "eslint . --ext .ts,.tsx --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "npx tsc --noEmit"
    },
    "dependencies": {
        "@backtrade/logger": "workspace:*",
        "@backtrade/types": "workspace:*",
        "@backtrade/utils": "workspace:*",
        "handlebars": "^4.7.8",
        "mjml": "^4.18.0",
        "nodemailer": "^7.0.11",
        "zod": "4.2.1"
    },
    "devDependencies": {
        "@backtrade/eslint-config": "workspace:*",
        "@backtrade/tsconfig": "workspace:*",
        "@types/mjml": "^4.7.4",
        "@types/node": "25.0.2",
        "@types/nodemailer": "^7.0.4",
        "globals": "^16.5.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "8.50.0"
    },
