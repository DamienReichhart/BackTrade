<mjml>
    <mj-head>
        <mj-title>Reset Your BackTrade Password</mj-title>
        <mj-preview>Use this code to reset your BackTrade password</mj-preview>

        <!-- Include global styles -->
        <mj-include path="./partials/styles.mjml" />
    </mj-head>

    <mj-body background-color="#0b0f14">
        <!-- Header -->
        <mj-section padding="48px 24px 32px 24px">
            <mj-column>
                <mj-text align="center" padding="0">
                    <span
                        style="
                            font-size: 28px;
                            font-weight: 600;
                            color: #e6eef5;
                            letter-spacing: -0.5px;
                        "
                    >
                        ◈ BackTrade
                    </span>
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Main Card -->
        <mj-section padding="0 24px">
            <mj-column
                background-color="rgba(230, 238, 245, 0.06)"
                border-radius="16px"
                padding="40px 32px"
            >
                <!-- Reset badge -->
                <mj-text align="center" padding="0 0 8px 0">
                    <span class="badge badge-info">🔑 Password Reset</span>
                </mj-text>

                <!-- Main heading -->
                <mj-text
                    align="center"
                    font-size="28px"
                    font-weight="700"
                    color="#e6eef5"
                    padding="16px 0 8px 0"
                    line-height="1.3"
                >
                    Reset your password
                </mj-text>

                <!-- Subheading -->
                <mj-text
                    align="center"
                    font-size="16px"
                    color="rgba(230, 238, 245, 0.7)"
                    padding="0 0 32px 0"
                >
                    Hi {{ username }}, we received a request to reset your
                    BackTrade password. Use the verification code below to
                    complete the process.
                </mj-text>

                <!-- Verification code label -->
                <mj-text
                    font-size="12px"
                    font-weight="600"
                    color="rgba(230, 238, 245, 0.5)"
                    padding="0 0 16px 0"
                    text-transform="uppercase"
                    letter-spacing="1px"
                    align="center"
                >
                    Your Verification Code
                </mj-text>

                <!-- Verification Code Box -->
                <mj-text align="center" padding="0 0 24px 0">
                    <div class="code-box">{{ resetCode }}</div>
                </mj-text>

                <!-- Expiration notice -->
                <mj-text
                    align="center"
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.5)"
                    padding="0 0 24px 0"
                >
                    ⏱️ This code expires in {{ expirationMinutes }} minutes
                </mj-text>

                <!-- Security notice -->
                <mj-text
                    align="center"
                    font-size="13px"
                    color="rgba(230, 238, 245, 0.4)"
                    padding="0"
                >
                    🔒 If you didn't request a password reset, please ignore
                    this email. Your password will remain unchanged.
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Warning box -->
        <mj-section padding="24px 24px 0 24px">
            <mj-column
                background-color="rgba(239, 68, 68, 0.08)"
                border="1px solid rgba(239, 68, 68, 0.2)"
                border-radius="12px"
                padding="24px"
            >
                <mj-text
                    align="center"
                    font-size="15px"
                    font-weight="600"
                    color="#ef4444"
                    padding="0 0 12px 0"
                >
                    ⚠️ Didn't request this?
                </mj-text>

                <mj-text
                    align="center"
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.7)"
                    padding="0"
                >
                    If you didn't request a password reset, someone may be
                    trying to access your account. You can safely ignore this
                    email, but consider reviewing your account security.
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Security tips -->
        <mj-section padding="24px 24px 0 24px">
            <mj-column
                background-color="rgba(230, 238, 245, 0.03)"
                border-radius="12px"
                padding="24px"
            >
                <mj-text
                    align="center"
                    font-size="14px"
                    font-weight="600"
                    color="#e6eef5"
                    padding="0 0 16px 0"
                >
                    🛡️ Password Tips
                </mj-text>

                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.6)"
                    padding="0 0 8px 0"
                >
                    • Use at least 8 characters with a mix of letters, numbers,
                    and symbols
                </mj-text>
                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.6)"
                    padding="0 0 8px 0"
                >
                    • Don't reuse passwords from other websites
                </mj-text>
                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.6)"
                    padding="0"
                >
                    • Consider using a password manager for security
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section padding="32px 24px 48px 24px">
            <mj-column>
                <mj-text
                    align="center"
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.5)"
                    padding="0 0 16px 0"
                >
                    This is an automated security email from BackTrade.
                </mj-text>
                <mj-text
                    align="center"
                    font-size="12px"
                    color="rgba(230, 238, 245, 0.3)"
                    padding="0"
                >
                    © {{ year }} BackTrade. All rights reserved.
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
