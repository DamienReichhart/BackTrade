<mjml>
    <mj-head>
        <mj-title>Reset your BackTrade password</mj-title>
        <mj-preview>Use this code to reset your BackTrade password.</mj-preview>

        <!-- Include global styles -->
        <mj-include path="./partials/styles.mjml" />
    </mj-head>

    <mj-body background-color="#0b0f14">
        <!-- Masthead -->
        <mj-section padding="48px 24px 0 24px">
            <mj-column>
                <mj-text padding="0">
                    <span
                        style="
                            font-size: 24px;
                            font-weight: 600;
                            color: #e6eef5;
                            letter-spacing: -0.5px;
                        "
                    >
                        ◈ BackTrade
                    </span>
                </mj-text>
                <mj-divider
                    border-color="rgba(230, 238, 245, 0.1)"
                    border-width="1px"
                    padding="20px 0 0 0"
                />
            </mj-column>
        </mj-section>

        <!-- Main Card -->
        <mj-section padding="32px 24px 0 24px">
            <mj-column
                background-color="rgba(230, 238, 245, 0.06)"
                border-radius="12px"
                padding="40px 32px"
            >
                <!-- Reset badge -->
                <mj-text padding="0 0 16px 0">
                    <span class="badge badge-info">Password reset</span>
                </mj-text>

                <!-- Main heading -->
                <mj-text
                    font-size="24px"
                    font-weight="700"
                    color="#e6eef5"
                    padding="0 0 16px 0"
                    line-height="1.3"
                >
                    Reset your password
                </mj-text>

                <!-- Body -->
                <mj-text
                    font-size="16px"
                    color="rgba(230, 238, 245, 0.75)"
                    padding="0 0 28px 0"
                >
                    Dear {{ username }},<br /><br />
                    We received a request to reset the password for your
                    BackTrade account. Use the verification code below to
                    continue.
                </mj-text>

                <!-- Verification code label -->
                <mj-text
                    font-size="12px"
                    font-weight="600"
                    color="rgba(230, 238, 245, 0.5)"
                    padding="0 0 16px 0"
                    text-transform="uppercase"
                    letter-spacing="1px"
                >
                    Your verification code
                </mj-text>

                <!-- Verification Code Box -->
                <mj-text padding="0 0 24px 0">
                    <div class="code-box">{{ resetCode }}</div>
                </mj-text>

                <!-- Expiration notice -->
                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.5)"
                    padding="0 0 24px 0"
                >
                    This code expires in {{ expirationMinutes }} minutes.
                </mj-text>

                <!-- Security notice -->
                <mj-text
                    font-size="13px"
                    color="rgba(230, 238, 245, 0.4)"
                    padding="0"
                >
                    If you did not request a password reset, you can disregard
                    this email. Your password will remain unchanged.
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Warning box -->
        <mj-section padding="24px 24px 0 24px">
            <mj-column
                background-color="rgba(239, 68, 68, 0.08)"
                border="1px solid rgba(239, 68, 68, 0.2)"
                border-radius="12px"
                padding="24px"
            >
                <mj-text
                    font-size="15px"
                    font-weight="600"
                    color="#ef4444"
                    padding="0 0 12px 0"
                >
                    Did not request this?
                </mj-text>

                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.7)"
                    padding="0"
                >
                    If you did not request a password reset, someone may be
                    attempting to access your account. You can disregard this
                    email, but we recommend reviewing your account security.
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Password recommendations -->
        <mj-section padding="24px 24px 0 24px">
            <mj-column
                background-color="rgba(230, 238, 245, 0.03)"
                border-radius="12px"
                padding="24px"
            >
                <mj-text
                    font-size="14px"
                    font-weight="600"
                    color="#e6eef5"
                    padding="0 0 16px 0"
                >
                    Password recommendations
                </mj-text>

                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.6)"
                    padding="0 0 8px 0"
                >
                    • Use at least 8 characters, combining letters, numbers, and
                    symbols.
                </mj-text>
                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.6)"
                    padding="0 0 8px 0"
                >
                    • Do not reuse passwords from other websites.
                </mj-text>
                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.6)"
                    padding="0"
                >
                    • Consider using a password manager.
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Sign-off -->
        <mj-section padding="32px 24px 0 24px">
            <mj-column>
                <mj-text
                    font-size="15px"
                    color="rgba(230, 238, 245, 0.75)"
                    padding="0"
                >
                    Kind regards,<br />
                    The BackTrade Team
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section padding="32px 24px 48px 24px">
            <mj-column>
                <mj-divider
                    border-color="rgba(230, 238, 245, 0.1)"
                    border-width="1px"
                    padding="0 0 24px 0"
                />
                <mj-text
                    font-size="13px"
                    color="rgba(230, 238, 245, 0.5)"
                    padding="0 0 12px 0"
                >
                    This is an automated security email from BackTrade. For
                    assistance, contact us at
                    <a href="mailto:contact@damien-reichhart.fr"
                        >contact@damien-reichhart.fr</a
                    >.
                </mj-text>
                <mj-text
                    font-size="12px"
                    color="rgba(230, 238, 245, 0.3)"
                    padding="0"
                >
                    © {{ year }} BackTrade. All rights reserved.
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
