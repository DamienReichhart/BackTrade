<mjml>
    <mj-head>
        <mj-title>New sign-in to BackTrade</mj-title>
        <mj-preview
            >A new sign-in to your BackTrade account was detected.</mj-preview
        >

        <!-- Include global styles -->
        <mj-include path="./partials/styles.mjml" />
    </mj-head>

    <mj-body background-color="#0b0f14">
        <!-- Masthead -->
        <mj-section padding="48px 24px 0 24px">
            <mj-column>
                <mj-text padding="0">
                    <span
                        style="
                            font-size: 24px;
                            font-weight: 600;
                            color: #e6eef5;
                            letter-spacing: -0.5px;
                        "
                    >
                        ◈ BackTrade
                    </span>
                </mj-text>
                <mj-divider
                    border-color="rgba(230, 238, 245, 0.1)"
                    border-width="1px"
                    padding="20px 0 0 0"
                />
            </mj-column>
        </mj-section>

        <!-- Main Card -->
        <mj-section padding="32px 24px 0 24px">
            <mj-column
                background-color="rgba(230, 238, 245, 0.06)"
                border-radius="12px"
                padding="40px 32px"
            >
                <!-- Security badge -->
                <mj-text padding="0 0 16px 0">
                    <span class="badge badge-info">Security notice</span>
                </mj-text>

                <!-- Main heading -->
                <mj-text
                    font-size="24px"
                    font-weight="700"
                    color="#e6eef5"
                    padding="0 0 16px 0"
                    line-height="1.3"
                >
                    New sign-in to your account
                </mj-text>

                <!-- Body -->
                <mj-text
                    font-size="16px"
                    color="rgba(230, 238, 245, 0.75)"
                    padding="0 0 28px 0"
                >
                    Dear {{ username }},<br /><br />
                    We detected a new sign-in to your BackTrade account. The
                    details are shown below.
                </mj-text>

                <!-- Sign-in details label -->
                <mj-text
                    font-size="12px"
                    font-weight="600"
                    color="rgba(230, 238, 245, 0.5)"
                    padding="0 0 16px 0"
                    text-transform="uppercase"
                    letter-spacing="1px"
                >
                    Sign-in details
                </mj-text>

                <!-- Date & Time -->
                <mj-text padding="0 0 12px 0">
                    <table
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        style="
                            border-bottom: 1px solid rgba(230, 238, 245, 0.08);
                        "
                    >
                        <tr>
                            <td
                                style="
                                    padding: 12px 0;
                                    font-size: 14px;
                                    color: rgba(230, 238, 245, 0.5);
                                "
                            >
                                Date &amp; Time
                            </td>
                            <td
                                style="
                                    padding: 12px 0;
                                    font-size: 14px;
                                    color: #e6eef5;
                                    font-weight: 500;
                                    text-align: right;
                                "
                            >
                                {{ loginDate }}
                            </td>
                        </tr>
                    </table>
                </mj-text>

                <!-- Device -->
                <mj-text padding="0 0 12px 0">
                    <table
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        style="
                            border-bottom: 1px solid rgba(230, 238, 245, 0.08);
                        "
                    >
                        <tr>
                            <td
                                style="
                                    padding: 12px 0;
                                    font-size: 14px;
                                    color: rgba(230, 238, 245, 0.5);
                                "
                            >
                                Device
                            </td>
                            <td
                                style="
                                    padding: 12px 0;
                                    font-size: 14px;
                                    color: #e6eef5;
                                    font-weight: 500;
                                    text-align: right;
                                "
                            >
                                {{ device }}
                            </td>
                        </tr>
                    </table>
                </mj-text>

                <!-- Browser -->
                <mj-text padding="0">
                    <table width="100%" cellpadding="0" cellspacing="0">
                        <tr>
                            <td
                                style="
                                    padding: 12px 0;
                                    font-size: 14px;
                                    color: rgba(230, 238, 245, 0.5);
                                "
                            >
                                Browser
                            </td>
                            <td
                                style="
                                    padding: 12px 0;
                                    font-size: 14px;
                                    color: #e6eef5;
                                    font-weight: 500;
                                    text-align: right;
                                "
                            >
                                {{ browser }}
                            </td>
                        </tr>
                    </table>
                </mj-text>

                <!-- Confirmation message -->
                <mj-text
                    font-size="15px"
                    color="rgba(230, 238, 245, 0.7)"
                    padding="24px 0 0 0"
                >
                    If this was you, no action is required.
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Warning box -->
        <mj-section padding="24px 24px 0 24px">
            <mj-column
                background-color="rgba(239, 68, 68, 0.08)"
                border="1px solid rgba(239, 68, 68, 0.2)"
                border-radius="12px"
                padding="24px"
            >
                <mj-text
                    font-size="15px"
                    font-weight="600"
                    color="#ef4444"
                    padding="0 0 12px 0"
                >
                    Did not recognize this activity?
                </mj-text>

                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.7)"
                    padding="0 0 20px 0"
                >
                    If you did not sign in, your account may be at risk. We
                    recommend securing it by changing your password immediately.
                </mj-text>

                <mj-button
                    href="{{secureAccountUrl}}"
                    background-color="#ef4444"
                    align="left"
                >
                    Secure your account
                </mj-button>
            </mj-column>
        </mj-section>

        <!-- Security recommendations -->
        <mj-section padding="24px 24px 0 24px">
            <mj-column
                background-color="rgba(230, 238, 245, 0.03)"
                border-radius="12px"
                padding="24px"
            >
                <mj-text
                    font-size="14px"
                    font-weight="600"
                    color="#e6eef5"
                    padding="0 0 16px 0"
                >
                    Security recommendations
                </mj-text>

                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.6)"
                    padding="0 0 8px 0"
                >
                    • Use a strong, unique password for your account.
                </mj-text>
                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.6)"
                    padding="0 0 8px 0"
                >
                    • Never share your login credentials.
                </mj-text>
                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.6)"
                    padding="0"
                >
                    • Review your account activity regularly.
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Sign-off -->
        <mj-section padding="32px 24px 0 24px">
            <mj-column>
                <mj-text
                    font-size="15px"
                    color="rgba(230, 238, 245, 0.75)"
                    padding="0"
                >
                    Kind regards,<br />
                    The BackTrade Team
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section padding="32px 24px 48px 24px">
            <mj-column>
                <mj-divider
                    border-color="rgba(230, 238, 245, 0.1)"
                    border-width="1px"
                    padding="0 0 24px 0"
                />
                <mj-text
                    font-size="13px"
                    color="rgba(230, 238, 245, 0.5)"
                    padding="0 0 12px 0"
                >
                    This is an automated security notification from BackTrade.
                    For assistance, contact us at
                    <a href="mailto:contact@damien-reichhart.fr"
                        >contact@damien-reichhart.fr</a
                    >.
                </mj-text>
                <mj-text
                    font-size="12px"
                    color="rgba(230, 238, 245, 0.3)"
                    padding="0"
                >
                    © {{ year }} BackTrade. All rights reserved.
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
