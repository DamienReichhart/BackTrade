<mjml>
    <mj-head>
        <mj-title>Welcome to BackTrade</mj-title>
        <mj-preview>Your BackTrade account is ready to use.</mj-preview>

        <!-- Include global styles -->
        <mj-include path="./partials/styles.mjml" />
    </mj-head>

    <mj-body background-color="#0b0f14">
        <!-- Masthead -->
        <mj-section padding="48px 24px 0 24px">
            <mj-column>
                <mj-text padding="0">
                    <span
                        style="
                            font-size: 24px;
                            font-weight: 600;
                            color: #e6eef5;
                            letter-spacing: -0.5px;
                        "
                    >
                        ◈ BackTrade
                    </span>
                </mj-text>
                <mj-divider
                    border-color="rgba(230, 238, 245, 0.1)"
                    border-width="1px"
                    padding="20px 0 0 0"
                />
            </mj-column>
        </mj-section>

        <!-- Main Card -->
        <mj-section padding="32px 24px 0 24px">
            <mj-column
                background-color="rgba(230, 238, 245, 0.06)"
                border-radius="12px"
                padding="40px 32px"
            >
                <!-- Welcome badge -->
                <mj-text padding="0 0 16px 0">
                    <span class="badge badge-success">Welcome</span>
                </mj-text>

                <!-- Main heading -->
                <mj-text
                    font-size="24px"
                    font-weight="700"
                    color="#e6eef5"
                    padding="0 0 16px 0"
                    line-height="1.3"
                >
                    Your account is ready
                </mj-text>

                <!-- Body -->
                <mj-text
                    font-size="16px"
                    color="rgba(230, 238, 245, 0.75)"
                    padding="0 0 28px 0"
                >
                    Dear {{ username }},<br /><br />
                    Thank you for creating a BackTrade account. Your account has
                    been set up successfully and is ready to use.
                </mj-text>

                <!-- CTA Button -->
                <mj-button href="{{dashboardUrl}}" align="left">
                    Go to dashboard
                </mj-button>

                <!-- Security notice -->
                <mj-text
                    font-size="13px"
                    color="rgba(230, 238, 245, 0.4)"
                    padding="28px 0 0 0"
                >
                    If you did not create this account, please contact us at
                    <a href="mailto:contact@damien-reichhart.fr"
                        >contact@damien-reichhart.fr</a
                    >.
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Features info box -->
        <mj-section padding="24px 24px 0 24px">
            <mj-column
                background-color="rgba(230, 238, 245, 0.03)"
                border-radius="12px"
                padding="24px"
            >
                <mj-text
                    font-size="14px"
                    font-weight="600"
                    color="#e6eef5"
                    padding="0 0 16px 0"
                >
                    What you can do with BackTrade
                </mj-text>

                <mj-text padding="0">
                    <span class="feature-tag">Backtest strategies</span>
                    <span class="feature-tag">Analyze performance</span>
                    <span class="feature-tag">Track KPIs</span>
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Sign-off -->
        <mj-section padding="32px 24px 0 24px">
            <mj-column>
                <mj-text
                    font-size="15px"
                    color="rgba(230, 238, 245, 0.75)"
                    padding="0"
                >
                    Kind regards,<br />
                    The BackTrade Team
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section padding="32px 24px 48px 24px">
            <mj-column>
                <mj-divider
                    border-color="rgba(230, 238, 245, 0.1)"
                    border-width="1px"
                    padding="0 0 24px 0"
                />
                <mj-text
                    font-size="13px"
                    color="rgba(230, 238, 245, 0.5)"
                    padding="0 0 12px 0"
                >
                    This is an automated message from BackTrade. For assistance,
                    contact us at
                    <a href="mailto:contact@damien-reichhart.fr"
                        >contact@damien-reichhart.fr</a
                    >.
                </mj-text>
                <mj-text
                    font-size="12px"
                    color="rgba(230, 238, 245, 0.3)"
                    padding="0"
                >
                    © {{ year }} BackTrade. All rights reserved.
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
