<mjml>
    <mj-head>
        <mj-title>Your BackTrade account has been deleted</mj-title>
        <mj-preview
            >Your BackTrade account has been permanently deleted.</mj-preview
        >

        <!-- Include global styles -->
        <mj-include path="./partials/styles.mjml" />
    </mj-head>

    <mj-body background-color="#0b0f14">
        <!-- Masthead -->
        <mj-section padding="48px 24px 0 24px">
            <mj-column>
                <mj-text padding="0">
                    <span
                        style="
                            font-size: 24px;
                            font-weight: 600;
                            color: #e6eef5;
                            letter-spacing: -0.5px;
                        "
                    >
                        ◈ BackTrade
                    </span>
                </mj-text>
                <mj-divider
                    border-color="rgba(230, 238, 245, 0.1)"
                    border-width="1px"
                    padding="20px 0 0 0"
                />
            </mj-column>
        </mj-section>

        <!-- Main Card -->
        <mj-section padding="32px 24px 0 24px">
            <mj-column
                background-color="rgba(230, 238, 245, 0.06)"
                border-radius="12px"
                padding="40px 32px"
            >
                <!-- Deletion badge -->
                <mj-text padding="0 0 16px 0">
                    <span class="badge badge-warning">Account deleted</span>
                </mj-text>

                <!-- Main heading -->
                <mj-text
                    font-size="24px"
                    font-weight="700"
                    color="#e6eef5"
                    padding="0 0 16px 0"
                    line-height="1.3"
                >
                    Account deletion confirmed
                </mj-text>

                <!-- Body -->
                <mj-text
                    font-size="16px"
                    color="rgba(230, 238, 245, 0.75)"
                    padding="0 0 28px 0"
                >
                    Dear {{ username }},<br /><br />
                    Your BackTrade account has been permanently deleted, as
                    requested.
                </mj-text>

                <!-- Deletion details label -->
                <mj-text
                    font-size="12px"
                    font-weight="600"
                    color="rgba(230, 238, 245, 0.5)"
                    padding="0 0 16px 0"
                    text-transform="uppercase"
                    letter-spacing="1px"
                >
                    Deletion details
                </mj-text>

                <!-- Deletion date -->
                <mj-text padding="0">
                    <table width="100%" cellpadding="0" cellspacing="0">
                        <tr>
                            <td
                                style="
                                    padding: 12px 0;
                                    font-size: 14px;
                                    color: rgba(230, 238, 245, 0.5);
                                "
                            >
                                Deletion Date
                            </td>
                            <td
                                style="
                                    padding: 12px 0;
                                    font-size: 14px;
                                    color: #e6eef5;
                                    font-weight: 500;
                                    text-align: right;
                                "
                            >
                                {{ deletionDate }}
                            </td>
                        </tr>
                    </table>
                </mj-text>

                <!-- Important notice -->
                <mj-text
                    font-size="15px"
                    color="rgba(230, 238, 245, 0.7)"
                    padding="24px 0 0 0"
                >
                    All of your data, including sessions, positions, and
                    transactions, has been permanently removed and cannot be
                    recovered.
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Warning box -->
        <mj-section padding="24px 24px 0 24px">
            <mj-column
                background-color="rgba(239, 68, 68, 0.08)"
                border="1px solid rgba(239, 68, 68, 0.2)"
                border-radius="12px"
                padding="24px"
            >
                <mj-text
                    font-size="15px"
                    font-weight="600"
                    color="#ef4444"
                    padding="0 0 12px 0"
                >
                    This action cannot be undone
                </mj-text>

                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.7)"
                    padding="0"
                >
                    Your account cannot be recovered. If you did not request this
                    deletion, please contact us immediately at
                    <a href="mailto:contact@damien-reichhart.fr"
                        >contact@damien-reichhart.fr</a
                    >.
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- What was deleted info box -->
        <mj-section padding="24px 24px 0 24px">
            <mj-column
                background-color="rgba(230, 238, 245, 0.03)"
                border-radius="12px"
                padding="24px"
            >
                <mj-text
                    font-size="14px"
                    font-weight="600"
                    color="#e6eef5"
                    padding="0 0 16px 0"
                >
                    What was removed
                </mj-text>

                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.6)"
                    padding="0 0 8px 0"
                >
                    • Your account profile and settings
                </mj-text>
                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.6)"
                    padding="0 0 8px 0"
                >
                    • All trading sessions and historical data
                </mj-text>
                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.6)"
                    padding="0 0 8px 0"
                >
                    • All positions and transactions
                </mj-text>
                <mj-text
                    font-size="14px"
                    color="rgba(230, 238, 245, 0.6)"
                    padding="0"
                >
                    • Subscription and billing information
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Sign-off -->
        <mj-section padding="32px 24px 0 24px">
            <mj-column>
                <mj-text
                    font-size="15px"
                    color="rgba(230, 238, 245, 0.75)"
                    padding="0"
                >
                    Kind regards,<br />
                    The BackTrade Team
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section padding="32px 24px 48px 24px">
            <mj-column>
                <mj-divider
                    border-color="rgba(230, 238, 245, 0.1)"
                    border-width="1px"
                    padding="0 0 24px 0"
                />
                <mj-text
                    font-size="13px"
                    color="rgba(230, 238, 245, 0.5)"
                    padding="0 0 12px 0"
                >
                    This is an automated confirmation email from BackTrade. If
                    you did not request this deletion, please contact us
                    immediately at
                    <a href="mailto:contact@damien-reichhart.fr"
                        >contact@damien-reichhart.fr</a
                    >.
                </mj-text>
                <mj-text
                    font-size="12px"
                    color="rgba(230, 238, 245, 0.3)"
                    padding="0"
                >
                    © {{ year }} BackTrade. All rights reserved.
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
